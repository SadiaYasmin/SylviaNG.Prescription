{
  "realm": "prescriptionms",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "Admin", "description": "Hospital administrator" },
      { "name": "Doctor", "description": "Doctor" },
      { "name": "Staff", "description": "Front-desk / assistant staff" }
    ]
  },
  "clients": [
    {
      "clientId": "prescriptionms-backend",
      "name": "PrescriptionMS Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "prescriptionms-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-role-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "http://schemas\\.microsoft\\.com/ws/2008/06/identity/claims/role",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-prescriptionms-backend",
      "enabled": true,
      "serviceAccountClientId": "prescriptionms-backend",
      "clientRoles": {
        "realm-management": ["manage-users", "view-realm"]
      }
    }
  ]
}
